# ─── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/decentra-social

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=your-strong-jwt-secret-here
JWT_EXPIRY=7d

# ─── Blockchain (Ganache) ───────────────────────────────────
GANACHE_URL=http://127.0.0.1:8545
DEPLOYER_PRIVATE_KEY=0x_paste_private_key_from_ganache_here

# ─── Contract Addresses (fill after: npx hardhat run scripts/deploy.ts) ───
USER_REGISTRY_ADDRESS=0x_paste_after_deployment
POST_REGISTRY_ADDRESS=0x_paste_after_deployment
MODERATION_CONTRACT_ADDRESS=0x_paste_after_deployment

# ─── IPFS / Pinata (https://pinata.cloud) ───────────────────
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# ─── ML Service ─────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ─── Server ─────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── Encryption ─────────────────────────────────────────────
AES_SECRET_KEY=your-32-character-secret-key-here
